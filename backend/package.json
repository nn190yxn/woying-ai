{
  "name": "woai-ai-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development node --watch src/index.js",
    "start": "node src/index.js",
    "build": "echo 'No build step needed for Node.js'",
    "check:env": "node scripts/check-env-presence.js",
    "smoke:core": "node scripts/smoke-core-endpoints.js",
    "deep:test": "node scripts/deep-test-runner.js",
    "test:deep-runner": "node --test scripts/deep-test-runner.test.js",
    "test:douyin-diagnosis": "node --test scripts/douyin-diagnosis.test.js",
    "test:quick-plan-semantic": "node --test scripts/quick-plan-semantic.test.js",
    "test:quick-plan-input": "node --test scripts/quick-plan-input.test.js",
    "test:quick-plan-generator": "node --test scripts/quick-plan-generator.test.js",
    "test:quick-plan-migration": "node --test scripts/quick-plan-migration.test.js",
    "test:quick-plan-saved-api": "node --test scripts/quick-plan-saved-api.test.js",
    "test:quick-plan-properties": "node --test scripts/quick-plan-properties.test.js",
    "test:quick-plan": "npm run test:quick-plan-input && npm run test:quick-plan-generator && npm run test:quick-plan-migration && npm run test:quick-plan-saved-api && npm run test:quick-plan-semantic && npm run test:quick-plan-properties"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.9.2",
    "ioredis": "^5.3.2",
    "dayjs": "^1.11.10",
    "axios": "^1.6.7",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0"
  }
}
