PORT=3001
NODE_ENV=development
GUEST_MODE=true
LOG_LEVEL=info
LOG_DIR=./logs

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=woai_ai

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=woai_ai

USE_REAL_REDIS=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MCAI_LLM_API_KEY=your_llm_api_key_here
MCAI_LLM_BASE_URL=https://proxy.monkeycode-ai.com/v1
MCAI_LLM_MODEL=gpt-5.5
AI_REQUEST_TIMEOUT=60000
AI_MAX_RETRIES=2
AI_FALLBACK_API_KEY=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_MODEL=gpt-5.5

KB_ROOT_PATH=../knowledge-base
KB_MAX_CONTEXT_CHARS=4500
KB_MAX_FILE_CHARS=1800
KB_VECTOR_TOPK=8
KB_RETRIEVAL_MODE=mapping_only

PAYMENT_CALLBACK_SECRET=your_payment_callback_secret_here
FRONTEND_BASE_URL=http://localhost:5173

REFERRAL_BONUS_DAYS_PER_REFERRAL=1
REFERRAL_COMMISSION_RATE=0.2
REFERRAL_COMMISSION_COOLDOWN_DAYS=7

CRON_SECRET=your_cron_secret_here
